{
  "name": "ts-grm-migrate",
  "version": "0.1.0-alpha.0",
  "packageManager": "yarn@4.1.0",
  "type": "module",
  "description": "Schema migration engine for ts-grm — inspired by Prisma Migrate (prisma-engines) and drizzle-kit",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES"
  ],
  "bin": {
    "tgm": "dist/bin.mjs",
    "ts-grm-migrate": "dist/bin.mjs"
  },
  "scripts": {
    "test": "vitest run --exclude tests/manual-postgres.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test:servers": "bash scripts/test-server-databases.sh",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test:coverage": "vitest run --coverage --exclude tests/manual-postgres.test.ts",
    "check": "yarn lint && yarn typecheck && yarn build && yarn test",
    "test:compat": "node scripts/test-compatibility.mjs",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run build",
    "test:postgres-mysql": "bash scripts/test-postgres-mysql.sh"
  },
  "peerDependencies": {
    "@ts-grm/core": ">=0.0.9 <0.0.14",
    "@ts-grm/sql": ">=0.0.9 <0.0.14",
    "better-sqlite3": ">=11",
    "mssql": ">=12",
    "mysql2": ">=3",
    "oracledb": ">=6",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mssql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "oracledb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@ts-grm/core": "^0.0.13",
    "@ts-grm/sql": "^0.0.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mssql": "^12.3.0",
    "@types/node": "^25.0.3",
    "@types/oracledb": "^7",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "4.0.16",
    "better-sqlite3": "^13.0.3",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.2",
    "oracledb": "^7",
    "pg": "^8.23.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "4.0.16"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0"
  }
}
