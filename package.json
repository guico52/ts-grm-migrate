{
  "name": "ts-grm-migrate",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.1.0",
  "type": "module",
  "description": "Schema migration engine for ts-grm — inspired by Prisma Migrate (prisma-engines) and drizzle-kit",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "bin": {
    "tgm": "./dist/cli.js",
    "ts-grm-migrate": "./dist/cli.js"
  },
  "scripts": {
    "test": "vitest run --exclude tests/manual-postgres.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test:servers": "bash scripts/test-server-databases.sh"
  },
  "peerDependencies": {
    "@ts-grm/core": "^0.0.13",
    "@ts-grm/sql": "^0.0.13",
    "better-sqlite3": ">=11",
    "mssql": ">=12",
    "mysql2": ">=3",
    "oracledb": ">=6",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mssql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "oracledb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ts-grm/core": "^0.0.13",
    "@ts-grm/sql": "^0.0.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mssql": "^12.3.0",
    "@types/node": "^25.0.3",
    "@types/oracledb": "^7",
    "@types/pg": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.2",
    "oracledb": "^7",
    "pg": "^8.23.0",
    "typescript": "^6.0.3",
    "vitest": "4.0.16"
  }
}
