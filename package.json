{
  "name": "@ts-grm/migrate",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.1.0",
  "type": "module",
  "description": "Schema migration engine for ts-grm — inspired by Prisma Migrate (prisma-engines) and drizzle-kit",
  "workspaces": [
    "../../source/ts-grm/packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ts-grm/sql": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^6.0.3",
    "vitest": "4.0.16"
  }
}
